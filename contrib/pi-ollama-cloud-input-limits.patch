diff --git a/models.ts b/models.ts
index 2f24e7b..678423d 100644
--- a/models.ts
+++ b/models.ts
@@ -34,6 +34,26 @@ function resolveMaxTokens(id: string): number {
   return MODEL_MAX_OUTPUT_TOKENS[id] ?? 32768;
 }
 
+// --- Image input limits ---
+// Ollama Cloud caps the serialized request body (measured: ~7.5 MB accepted,
+// 8.08 MB rejected with 413 Request Entity Too Large; much larger bodies are cut
+// mid-upload and surface as 400 "failed to read request body"). `read` and
+// tool-result images stay in conversation history as base64, so a dozen or so
+// full-size screenshots exhaust the cap and every following turn fails. Declaring
+// resize limits makes pi downscale each image before storing it; pi re-encodes
+// until the base64 payload fits `maxBytes`. 512 KiB is conservative enough for
+// multiple screenshots in one request while keeping 1400px of detail.
+export const VISION_INPUT_LIMITS: NonNullable<ChatModelConfig["inputLimits"]> = {
+  images: {
+    resize: {
+      maxWidth: 1400,
+      maxHeight: 1400,
+      maxBytes: 524288,
+      jpegQuality: 75,
+    },
+  },
+};
+
 // --- Constants ---
 const FETCH_TIMEOUT_MS = 10000;
 // How long a stored catalog is considered fresh before the next network refresh
@@ -156,17 +176,22 @@ export function assembleModels(raw: Record<string, unknown>): ChatModelConfig[]
       return [id, data] as const;
     })
     .filter(([, data]) => data.capabilities.includes("tools"))
-    .map(([id, data]) => ({
-      id,
-      name: id,
-      reasoning: data.capabilities.includes("thinking"),
-      thinkingLevelMap: resolveThinkingLevelMap(id, data.capabilities),
-      input: (data.capabilities.includes("vision") ? ["text", "image"] : ["text"]) as ("text" | "image")[],
-      cost: resolvePrice(id),
-      contextWindow: getContextLength(data.model_info ?? {}),
-      maxTokens: resolveMaxTokens(id),
-      compat: buildCompat(),
-    }));
+    .map(([id, data]) => {
+      const supportsVision = data.capabilities.includes("vision");
+      return {
+        id,
+        name: id,
+        reasoning: data.capabilities.includes("thinking"),
+        thinkingLevelMap: resolveThinkingLevelMap(id, data.capabilities),
+        input: (supportsVision ? ["text", "image"] : ["text"]) as ("text" | "image")[],
+        // Only vision models need resize limits; text-only models never send images.
+        ...(supportsVision ? { inputLimits: VISION_INPUT_LIMITS } : {}),
+        cost: resolvePrice(id),
+        contextWindow: getContextLength(data.model_info ?? {}),
+        maxTokens: resolveMaxTokens(id),
+        compat: buildCompat(),
+      };
+    });
 }
 
